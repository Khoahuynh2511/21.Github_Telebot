# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Fine-grained GitHub token with only the repository permissions the bot needs
GITHUB_TOKEN=your_github_token

# Shared secret configured for the GitHub webhook
GITHUB_WEBHOOK_SECRET=replace_with_a_random_secret

# Local HTTP server
PORT=3000

# Public HTTPS URL used for webhook callbacks, if applicable
PUBLIC_URL=https://example.com

# Comma-separated Telegram user IDs allowed to administer the bot
ADMIN_USER_IDS=123456789
